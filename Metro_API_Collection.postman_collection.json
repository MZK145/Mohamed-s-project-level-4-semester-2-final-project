            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salah Salem\",\n  \"line\": \"Line 1\",\n  \"order\": 6,\n  \"governorate\": \"Cairo\",\n  \"city\": \"Cairo\",\n  \"arrivalTime\": \"08:15\",\n  \"departureTime\": \"08:20\"\n}"
