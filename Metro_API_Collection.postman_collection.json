            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salah Salem\",\n  \"line\": \"Line 1\",\n  \"order\": 7,\n  \"governorate\": \"Cairo\",\n  \"city\": \"Cairo\",\n  \"arrivalTime\": \"08:10\",\n  \"departureTime\": \"08:25\"\n}"
