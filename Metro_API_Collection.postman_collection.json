{
  "info": {
    "_postman_id": "metro-api-collection",
    "name": "Metro API Collection",
    "description": "Complete API collection for the Metro Backend project",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check if the server is running and healthy"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Stations",
      "item": [
        {
          "name": "GET All Stations (Sorted)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations",
              "host": [
                "{{base_url}}",
                "api",
                "v1",
                "stations"
              ]
            },
            "description": "Get all metro stations sorted by line and order"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@metro.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}",
                "api",
                "v1",
                "auth"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login as admin and receive JWT token. Use the returned token in the Authorization header for protected endpoints."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Announcements",
      "item": [
        {
          "name": "GET Station Announcements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/{{stationId}}/announcements",
              "host": [
                "{{base_url}}",
                "api",
                "v1",
                "stations",
                "{{stationId}}"
              ],
              "path": [
                "announcements"
              ]
            },
            "description": "Get all announcements for a specific station with pagination and filtering support"
          },
          "response": []
        },
        {
          "name": "POST Create Announcement (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "description": "JWT token from login endpoint"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Train delay of 5 minutes on Line 1\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/stations/{{stationId}}/announcements",
              "host": [
                "{{base_url}}",
                "api",
                "v1",
                "stations",
                "{{stationId}}"
              ],
              "path": [
                "announcements"
              ]
            },
            "description": "Create a new announcement for a station (admin authentication required). Message must be 1-500 characters."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Base URL for the API"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string",
      "description": "JWT token received from login endpoint"
    },
    {
      "key": "stationId",
      "value": "6719c6c1d5e3f9a1b2c3d4e5",
      "type": "string",
      "description": "MongoDB ObjectId of the station"
    }
  ]
}
