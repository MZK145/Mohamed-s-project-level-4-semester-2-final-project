# Backend Configuration
PORT=5000

# MongoDB Connection URI
# For local development: mongodb://localhost:27017/metro
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?appName=YourApp

# JWT Secret for token signing
# Use a strong, random secret in production
JWT_SECRET=your_jwt_secret_key_here
